# Function-scoped GNUstep findings, reproduced without Arlen. These are not
# classified as harmless. See docs/internal/TSAN_RELIABILITY_2026-09-21.md.
# Module registration / lazy Objective-C class initialization lock cycles.
deadlock:__objc_load
deadlock:objc_send_initialize
# Monitor allocation versus locking inside the runtime's @synchronized support.
race:objc_sync_enter
