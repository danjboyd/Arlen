#!/usr/bin/env bash
set -euo pipefail

print_usage() {
  cat <<'USAGE'
Usage: propane [options] [-- worker-args]

Runs Arlen in production manager mode with prefork workers.
Windows production hosting is unsupported; use boomhauer for Windows development.
All production manager settings are called "propane accessories".

Options:
  --workers <n>                     Override propane accessory workerCount
  --host <addr>                     Override bind host
  --port <port>                     Override bind port
  --env <name>                      Environment name (default: production)
  --pid-file <path>                 PID file path
  --graceful-shutdown-seconds <n>   Override propane accessory gracefulShutdownSeconds
  --respawn-delay-ms <n>            Override propane accessory respawnDelayMs
  --reload-overlap-seconds <n>      Override propane accessory reloadOverlapSeconds
  --listen-backlog <n>              Override runtime listenBacklog
  --connection-timeout-seconds <n>  Override runtime connectionTimeoutSeconds
  --cluster-enabled                 Enable clustered runtime contracts
  --cluster-name <name>             Override cluster name
  --cluster-node-id <id>            Override cluster node ID
  --cluster-expected-nodes <n>      Override expected cluster node count
  --job-worker-cmd <command>        Spawn supervised async worker command
  --job-worker-count <n>            Number of supervised async worker processes
  --job-worker-respawn-delay-ms <n> Override async worker respawn delay
  --worker-fd-warn-percent <n>      Warn when worker FD usage reaches percent
  --worker-fd-critical-percent <n>  Critical log when worker FD usage reaches percent
  --worker-fd-retire-percent <n>    Gracefully recycle worker above percent (0 disables)
  --worker-fd-retire-count <n>      Gracefully recycle worker above FD count (0 disables)
  --worker-fd-check-seconds <n>     Worker FD pressure check interval
  --app-root <path>                 App root (default: ARLEN_APP_ROOT or cwd)
  --framework-root <path>           Framework root (default: ARLEN_FRAMEWORK_ROOT or script root)
  --no-respawn                      Disable worker respawn on crash/exit
  --once                            Pass --once to worker and exit after worker exits
  --print-routes                    Print routes via a single worker and exit
  --help, -h                        Show this help

Signals:
  TERM/INT: graceful shutdown
  HUP: rolling reload (start new workers, then retire old workers)

Environment:
  ARLEN_APP_ROOT
  ARLEN_FRAMEWORK_ROOT
  ARLEN_PROPANE_JOB_WORKER_COMMAND
  ARLEN_PROPANE_JOB_WORKER_COUNT
  ARLEN_PROPANE_WORKER_FD_WARN_PERCENT
  ARLEN_PROPANE_WORKER_FD_CRITICAL_PERCENT
  ARLEN_PROPANE_WORKER_FD_RETIRE_PERCENT
  ARLEN_PROPANE_WORKER_FD_RETIRE_COUNT
  ARLEN_PROPANE_WORKER_FD_CHECK_SECONDS
  ARLEN_PROPANE_LIFECYCLE_LOG
  ARLEN_CLUSTER_ENABLED
  ARLEN_CLUSTER_NAME
  ARLEN_CLUSTER_NODE_ID
  ARLEN_CLUSTER_EXPECTED_NODES
USAGE
}

script_path="${BASH_SOURCE[0]}"
if resolved="$(readlink -f "$script_path" 2>/dev/null)"; then
  script_path="$resolved"
fi
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
default_framework_root="$(cd "$script_dir/.." && pwd)"

path_looks_like_windows_absolute() {
  local path="$1"
  [[ "$path" =~ ^[A-Za-z]:[\\/] ]] || [[ "$path" =~ ^\\\\ ]]
}

path_is_absolute() {
  local path="$1"
  [[ "$path" == /* ]] || path_looks_like_windows_absolute "$path"
}

normalize_host_path() {
  local raw="$1"
  if [[ -z "$raw" ]]; then
    printf '%s\n' "$PWD"
    return
  fi
  if command -v cygpath >/dev/null 2>&1 && path_is_absolute "$raw"; then
    cygpath -au "$raw"
    return
  fi
  if path_is_absolute "$raw"; then
    printf '%s\n' "$raw"
    return
  fi
  printf '%s\n' "$PWD/$raw"
}

resolve_compiled_binary() {
  local candidate="$1"
  if [[ -x "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  if [[ "$candidate" != *.exe ]] && [[ -x "$candidate.exe" ]]; then
    printf '%s\n' "$candidate.exe"
    return 0
  fi
  return 1
}

app_root_has_sources() {
  local root="$1"
  if [[ -f "$root/app_lite.m" ]]; then
    return 0
  fi
  [[ -n "$(find "$root/src" -type f -name '*.m' -print -quit 2>/dev/null)" ]]
}

# macOS builds with the Apple toolchain (bin/build-apple) instead of GNU make,
# and writes its binaries to build/apple/ and .boomhauer/apple/.
is_apple_host=0
if [[ "$(uname -s)" == "Darwin" ]]; then
  is_apple_host=1
fi

framework_root="${ARLEN_FRAMEWORK_ROOT:-$default_framework_root}"
app_root="${ARLEN_APP_ROOT:-$PWD}"
environment="production"

workers_override=""
host_override=""
port_override=""
pid_file_override=""
graceful_override=""
respawn_delay_override=""
reload_overlap_override=""
listen_backlog_override=""
connection_timeout_override=""
cluster_enabled_override=""
cluster_name_override=""
cluster_node_id_override=""
cluster_expected_nodes_override=""
job_worker_cmd_override=""
job_worker_count_override=""
job_worker_respawn_delay_override=""
worker_fd_warn_percent_override=""
worker_fd_critical_percent_override=""
worker_fd_retire_percent_override=""
worker_fd_retire_count_override=""
worker_fd_check_seconds_override=""

no_respawn=0
once_mode=0
print_routes=0
worker_passthrough=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --workers)
      [[ $# -ge 2 ]] || { echo "propane: --workers requires a value" >&2; exit 2; }
      workers_override="$2"
      shift 2
      ;;
    --host)
      [[ $# -ge 2 ]] || { echo "propane: --host requires a value" >&2; exit 2; }
      host_override="$2"
      shift 2
      ;;
    --port)
      [[ $# -ge 2 ]] || { echo "propane: --port requires a value" >&2; exit 2; }
      port_override="$2"
      shift 2
      ;;
    --env)
      [[ $# -ge 2 ]] || { echo "propane: --env requires a value" >&2; exit 2; }
      environment="$2"
      shift 2
      ;;
    --pid-file)
      [[ $# -ge 2 ]] || { echo "propane: --pid-file requires a value" >&2; exit 2; }
      pid_file_override="$2"
      shift 2
      ;;
    --graceful-shutdown-seconds)
      [[ $# -ge 2 ]] || { echo "propane: --graceful-shutdown-seconds requires a value" >&2; exit 2; }
      graceful_override="$2"
      shift 2
      ;;
    --respawn-delay-ms)
      [[ $# -ge 2 ]] || { echo "propane: --respawn-delay-ms requires a value" >&2; exit 2; }
      respawn_delay_override="$2"
      shift 2
      ;;
    --reload-overlap-seconds)
      [[ $# -ge 2 ]] || { echo "propane: --reload-overlap-seconds requires a value" >&2; exit 2; }
      reload_overlap_override="$2"
      shift 2
      ;;
    --listen-backlog)
      [[ $# -ge 2 ]] || { echo "propane: --listen-backlog requires a value" >&2; exit 2; }
      listen_backlog_override="$2"
      shift 2
      ;;
    --connection-timeout-seconds)
      [[ $# -ge 2 ]] || { echo "propane: --connection-timeout-seconds requires a value" >&2; exit 2; }
      connection_timeout_override="$2"
      shift 2
      ;;
    --cluster-enabled)
      cluster_enabled_override="1"
      shift
      ;;
    --cluster-name)
      [[ $# -ge 2 ]] || { echo "propane: --cluster-name requires a value" >&2; exit 2; }
      cluster_name_override="$2"
      shift 2
      ;;
    --cluster-node-id)
      [[ $# -ge 2 ]] || { echo "propane: --cluster-node-id requires a value" >&2; exit 2; }
      cluster_node_id_override="$2"
      shift 2
      ;;
    --cluster-expected-nodes)
      [[ $# -ge 2 ]] || { echo "propane: --cluster-expected-nodes requires a value" >&2; exit 2; }
      cluster_expected_nodes_override="$2"
      shift 2
      ;;
    --job-worker-cmd)
      [[ $# -ge 2 ]] || { echo "propane: --job-worker-cmd requires a value" >&2; exit 2; }
      job_worker_cmd_override="$2"
      shift 2
      ;;
    --job-worker-count)
      [[ $# -ge 2 ]] || { echo "propane: --job-worker-count requires a value" >&2; exit 2; }
      job_worker_count_override="$2"
      shift 2
      ;;
    --job-worker-respawn-delay-ms)
      [[ $# -ge 2 ]] || { echo "propane: --job-worker-respawn-delay-ms requires a value" >&2; exit 2; }
      job_worker_respawn_delay_override="$2"
      shift 2
      ;;
    --worker-fd-warn-percent)
      [[ $# -ge 2 ]] || { echo "propane: --worker-fd-warn-percent requires a value" >&2; exit 2; }
      worker_fd_warn_percent_override="$2"
      shift 2
      ;;
    --worker-fd-critical-percent)
      [[ $# -ge 2 ]] || { echo "propane: --worker-fd-critical-percent requires a value" >&2; exit 2; }
      worker_fd_critical_percent_override="$2"
      shift 2
      ;;
    --worker-fd-retire-percent)
      [[ $# -ge 2 ]] || { echo "propane: --worker-fd-retire-percent requires a value" >&2; exit 2; }
      worker_fd_retire_percent_override="$2"
      shift 2
      ;;
    --worker-fd-retire-count)
      [[ $# -ge 2 ]] || { echo "propane: --worker-fd-retire-count requires a value" >&2; exit 2; }
      worker_fd_retire_count_override="$2"
      shift 2
      ;;
    --worker-fd-check-seconds)
      [[ $# -ge 2 ]] || { echo "propane: --worker-fd-check-seconds requires a value" >&2; exit 2; }
      worker_fd_check_seconds_override="$2"
      shift 2
      ;;
    --app-root)
      [[ $# -ge 2 ]] || { echo "propane: --app-root requires a value" >&2; exit 2; }
      app_root="$2"
      shift 2
      ;;
    --framework-root)
      [[ $# -ge 2 ]] || { echo "propane: --framework-root requires a value" >&2; exit 2; }
      framework_root="$2"
      shift 2
      ;;
    --no-respawn)
      no_respawn=1
      shift
      ;;
    --once)
      once_mode=1
      no_respawn=1
      worker_passthrough+=("--once")
      shift
      ;;
    --print-routes)
      print_routes=1
      once_mode=1
      no_respawn=1
      workers_override="1"
      worker_passthrough+=("--print-routes")
      shift
      ;;
    --help|-h)
      print_usage
      exit 0
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do
        worker_passthrough+=("$1")
        shift
      done
      ;;
    *)
      worker_passthrough+=("$1")
      shift
      ;;
  esac
done

case "$(uname -s)" in
  MSYS*|MINGW*|CYGWIN*)
    echo "propane: Windows production hosting is not supported; use boomhauer for development" >&2
    exit 2
    ;;
esac

framework_root="$(normalize_host_path "$framework_root")"
framework_root="$(cd "$framework_root" && pwd -P)"

app_root="$(normalize_host_path "$app_root")"
app_root="$(cd "$app_root" && pwd -P)"

is_checkout_framework_root=0
if [[ -f "$framework_root/GNUmakefile" && -d "$framework_root/src/Arlen" ]]; then
  is_checkout_framework_root=1
fi

is_release_framework_root=0
if resolve_compiled_binary "$framework_root/build/arlen" >/dev/null && [[ -x "$framework_root/bin/propane" ]]; then
  is_release_framework_root=1
fi

if (( is_checkout_framework_root == 0 && is_release_framework_root == 0 )); then
  echo "propane: invalid framework root: $framework_root" >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "propane: python3 is required to parse merged config output" >&2
  exit 1
fi

if (( is_checkout_framework_root == 1 && is_apple_host == 1 )); then
  "$framework_root/bin/build-apple" >/dev/null
  if ! arlen_binary="$(resolve_compiled_binary "$framework_root/build/apple/arlen")"; then
    echo "propane: expected compiled arlen binary under $framework_root/build/apple" >&2
    exit 1
  fi
elif (( is_checkout_framework_root == 1 )); then
  if ! arlen_binary="$(resolve_compiled_binary "$framework_root/build/arlen")"; then
    make -C "$framework_root" arlen >/dev/null
    if ! arlen_binary="$(resolve_compiled_binary "$framework_root/build/arlen")"; then
      echo "propane: expected compiled arlen binary under $framework_root/build" >&2
      exit 1
    fi
  fi
else
  if ! arlen_binary="$(resolve_compiled_binary "$framework_root/build/arlen")"; then
    echo "propane: expected compiled arlen binary under $framework_root/build" >&2
    exit 1
  fi
fi

# --show-secrets: values such as propaneAccessories.jobWorkerCommand must reach
# propane unredacted (arlen config masks embedded passwords by default).
config_json="$(cd "$app_root" && "$arlen_binary" config --env "$environment" --json --show-secrets 2>/dev/null || true)"
if [[ -z "$config_json" ]]; then
  echo "propane: failed to load app config via arlen config --json" >&2
  exit 1
fi

# The heredoc lives in a function: bash 3.2 misparses one nested in < <(...).
emit_config_values() {
  python3 - "$1" <<'PY'
import json
import sys

cfg = json.loads(sys.argv[1])
accessories = cfg.get("propaneAccessories") or {}
cluster = cfg.get("cluster") or {}

def as_int(value, default, minimum):
    try:
        parsed = int(value)
    except Exception:
        return default
    if parsed < minimum:
        return default
    return parsed

def as_bool(value, default=False):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in {"1", "true", "yes", "on"}:
            return True
        if normalized in {"0", "false", "no", "off"}:
            return False
    return default

def as_str(value, default=""):
    if isinstance(value, str):
        return value
    return default

print(f"config_host={cfg.get('host', '127.0.0.1')}")
print(f"config_port={as_int(cfg.get('port', 3000), 3000, 1)}")
print(f"config_workers={as_int(accessories.get('workerCount', 4), 4, 1)}")
print(f"config_rate_limit_enabled={1 if as_bool((cfg.get('rateLimit') or {}).get('enabled', False), False) else 0}")
print(f"config_graceful_shutdown_seconds={as_int(accessories.get('gracefulShutdownSeconds', 10), 10, 1)}")
print(f"config_respawn_delay_ms={as_int(accessories.get('respawnDelayMs', 250), 250, 0)}")
print(f"config_reload_overlap_seconds={as_int(accessories.get('reloadOverlapSeconds', 1), 1, 0)}")
print(f"config_listen_backlog={as_int(cfg.get('listenBacklog', 128), 128, 1)}")
print(f"config_connection_timeout_seconds={as_int(cfg.get('connectionTimeoutSeconds', 30), 30, 1)}")
print(f"config_enable_reuse_port={1 if as_bool(cfg.get('enableReusePort', False), False) else 0}")
print(f"config_job_worker_count={as_int(accessories.get('jobWorkerCount', 0), 0, 0)}")
print(f"config_job_worker_command={as_str(accessories.get('jobWorkerCommand', ''), '')}")
print(f"config_job_worker_respawn_delay_ms={as_int(accessories.get('jobWorkerRespawnDelayMs', 250), 250, 0)}")
print(f"config_cluster_enabled={1 if as_bool(cluster.get('enabled', False), False) else 0}")
print(f"config_cluster_name={as_str(cluster.get('name', 'default'), 'default')}")
print(f"config_cluster_node_id={as_str(cluster.get('nodeID', 'node'), 'node')}")
print(f"config_cluster_expected_nodes={as_int(cluster.get('expectedNodes', 1), 1, 1)}")
print(f"config_worker_fd_warn_percent={as_int(accessories.get('workerFDWarnPercent', 80), 80, 0)}")
print(f"config_worker_fd_critical_percent={as_int(accessories.get('workerFDCriticalPercent', 90), 90, 0)}")
print(f"config_worker_fd_retire_percent={as_int(accessories.get('workerFDRetirePercent', 0), 0, 0)}")
print(f"config_worker_fd_retire_count={as_int(accessories.get('workerFDRetireCount', 0), 0, 0)}")
print(f"config_worker_fd_check_seconds={as_int(accessories.get('workerFDCheckSeconds', 15), 15, 1)}")
storage_persistence = (cfg.get("storageModule") or {}).get("persistence") or {}
storage_unshared = "enabled" in storage_persistence and not as_bool(storage_persistence.get("enabled"), True)
print(f"config_storage_unshared={1 if storage_unshared else 0}")
print(f"config_startup_failure_limit={as_int(accessories.get('startupFailureLimit', 5), 5, 0)}")
print(f"config_respawn_backoff_max_ms={as_int(accessories.get('respawnBackoffMaxMs', 30000), 30000, 0)}")
PY
}

while IFS='=' read -r key value; do
  # Windows (CLANG64) python3 prints CRLF; keep "\r" out of every value.
  value="${value%$'\r'}"
  case "$key" in
    config_host) config_host="$value" ;;
    config_port) config_port="$value" ;;
    config_workers) config_workers="$value" ;;
    config_rate_limit_enabled) config_rate_limit_enabled="$value" ;;
    config_graceful_shutdown_seconds) config_graceful_shutdown_seconds="$value" ;;
    config_respawn_delay_ms) config_respawn_delay_ms="$value" ;;
    config_reload_overlap_seconds) config_reload_overlap_seconds="$value" ;;
    config_listen_backlog) config_listen_backlog="$value" ;;
    config_connection_timeout_seconds) config_connection_timeout_seconds="$value" ;;
    config_enable_reuse_port) config_enable_reuse_port="$value" ;;
    config_job_worker_count) config_job_worker_count="$value" ;;
    config_job_worker_command) config_job_worker_command="$value" ;;
    config_job_worker_respawn_delay_ms) config_job_worker_respawn_delay_ms="$value" ;;
    config_cluster_enabled) config_cluster_enabled="$value" ;;
    config_cluster_name) config_cluster_name="$value" ;;
    config_cluster_node_id) config_cluster_node_id="$value" ;;
    config_cluster_expected_nodes) config_cluster_expected_nodes="$value" ;;
    config_worker_fd_warn_percent) config_worker_fd_warn_percent="$value" ;;
    config_worker_fd_critical_percent) config_worker_fd_critical_percent="$value" ;;
    config_worker_fd_retire_percent) config_worker_fd_retire_percent="$value" ;;
    config_worker_fd_retire_count) config_worker_fd_retire_count="$value" ;;
    config_worker_fd_check_seconds) config_worker_fd_check_seconds="$value" ;;
    config_storage_unshared) config_storage_unshared="$value" ;;
    config_startup_failure_limit) config_startup_failure_limit="$value" ;;
    config_respawn_backoff_max_ms) config_respawn_backoff_max_ms="$value" ;;
  esac
done < <(emit_config_values "$config_json")

worker_count="${workers_override:-${config_workers:-4}}"
host="${host_override:-${config_host:-127.0.0.1}}"
port="${port_override:-${config_port:-3000}}"
graceful_shutdown_seconds="${graceful_override:-${config_graceful_shutdown_seconds:-10}}"
respawn_delay_ms="${respawn_delay_override:-${config_respawn_delay_ms:-250}}"
startup_failure_limit="${config_startup_failure_limit:-5}"
respawn_backoff_max_ms="${config_respawn_backoff_max_ms:-30000}"
reload_overlap_seconds="${reload_overlap_override:-${config_reload_overlap_seconds:-1}}"
listen_backlog="${listen_backlog_override:-${config_listen_backlog:-128}}"
connection_timeout_seconds="${connection_timeout_override:-${config_connection_timeout_seconds:-30}}"
enable_reuse_port="${config_enable_reuse_port:-0}"
job_worker_count="${job_worker_count_override:-${config_job_worker_count:-${ARLEN_PROPANE_JOB_WORKER_COUNT:-0}}}"
job_worker_command="${job_worker_cmd_override:-${config_job_worker_command:-${ARLEN_PROPANE_JOB_WORKER_COMMAND:-}}}"
job_worker_respawn_delay_ms="${job_worker_respawn_delay_override:-${config_job_worker_respawn_delay_ms:-${ARLEN_PROPANE_JOB_WORKER_RESPAWN_DELAY_MS:-250}}}"
worker_fd_warn_percent="${worker_fd_warn_percent_override:-${ARLEN_PROPANE_WORKER_FD_WARN_PERCENT:-${config_worker_fd_warn_percent:-80}}}"
worker_fd_critical_percent="${worker_fd_critical_percent_override:-${ARLEN_PROPANE_WORKER_FD_CRITICAL_PERCENT:-${config_worker_fd_critical_percent:-90}}}"
worker_fd_retire_percent="${worker_fd_retire_percent_override:-${ARLEN_PROPANE_WORKER_FD_RETIRE_PERCENT:-${config_worker_fd_retire_percent:-0}}}"
worker_fd_retire_count="${worker_fd_retire_count_override:-${ARLEN_PROPANE_WORKER_FD_RETIRE_COUNT:-${config_worker_fd_retire_count:-0}}}"
worker_fd_check_seconds="${worker_fd_check_seconds_override:-${ARLEN_PROPANE_WORKER_FD_CHECK_SECONDS:-${config_worker_fd_check_seconds:-15}}}"

is_uint() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

parse_bool_int() {
  local raw="${1:-}"
  local normalized
  normalized="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$normalized" in
    1|true|yes|on)
      echo "1"
      return 0
      ;;
    0|false|no|off)
      echo "0"
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

cluster_enabled_raw="${cluster_enabled_override:-${ARLEN_CLUSTER_ENABLED:-${config_cluster_enabled:-0}}}"
if ! cluster_enabled="$(parse_bool_int "$cluster_enabled_raw")"; then
  echo "propane: cluster enabled must be a boolean (got: $cluster_enabled_raw)" >&2
  exit 2
fi
cluster_name="${cluster_name_override:-${ARLEN_CLUSTER_NAME:-${config_cluster_name:-default}}}"
cluster_node_id="${cluster_node_id_override:-${ARLEN_CLUSTER_NODE_ID:-${config_cluster_node_id:-}}}"
cluster_expected_nodes="${cluster_expected_nodes_override:-${ARLEN_CLUSTER_EXPECTED_NODES:-${config_cluster_expected_nodes:-1}}}"

if [[ -z "$cluster_name" ]]; then
  cluster_name="default"
fi
if [[ -z "$cluster_node_id" ]]; then
  cluster_node_id="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo node)"
fi
if [[ -z "$cluster_node_id" ]]; then
  cluster_node_id="node"
fi

for numeric in "$worker_count" "$port" "$graceful_shutdown_seconds" "$respawn_delay_ms" "$reload_overlap_seconds" "$listen_backlog" "$connection_timeout_seconds" "$enable_reuse_port" "$job_worker_count" "$job_worker_respawn_delay_ms" "$cluster_expected_nodes" "$worker_fd_warn_percent" "$worker_fd_critical_percent" "$worker_fd_retire_percent" "$worker_fd_retire_count" "$worker_fd_check_seconds"; do
  if ! is_uint "$numeric"; then
    echo "propane: expected integer propane accessory/runtime value but got: $numeric" >&2
    exit 2
  fi
done

if (( worker_count > 1 )); then
  enable_reuse_port=1
fi

if (( worker_count < 1 )); then
  echo "propane: resolved worker count must be >= 1" >&2
  exit 2
fi
if (( graceful_shutdown_seconds < 1 )); then
  echo "propane: graceful shutdown seconds must be >= 1" >&2
  exit 2
fi
if (( respawn_delay_ms < 0 )); then
  echo "propane: respawn delay must be >= 0" >&2
  exit 2
fi
if (( reload_overlap_seconds < 0 )); then
  echo "propane: reload overlap seconds must be >= 0" >&2
  exit 2
fi
if (( listen_backlog < 1 )); then
  echo "propane: listen backlog must be >= 1" >&2
  exit 2
fi
if (( connection_timeout_seconds < 1 )); then
  echo "propane: connection timeout seconds must be >= 1" >&2
  exit 2
fi
if (( job_worker_count < 0 )); then
  echo "propane: job worker count must be >= 0" >&2
  exit 2
fi
if (( job_worker_count > 0 )) && [[ -z "$job_worker_command" ]]; then
  echo "propane: --job-worker-count requires --job-worker-cmd (or propane accessories jobWorkerCommand)" >&2
  exit 2
fi
if (( cluster_expected_nodes < 1 )); then
  echo "propane: cluster expected nodes must be >= 1" >&2
  exit 2
fi
if (( worker_fd_warn_percent > 100 || worker_fd_critical_percent > 100 || worker_fd_retire_percent > 100 )); then
  echo "propane: worker FD percent propane accessories must be <= 100" >&2
  exit 2
fi
if (( worker_fd_check_seconds < 1 )); then
  echo "propane: worker FD check seconds must be >= 1" >&2
  exit 2
fi

pid_file="${pid_file_override:-$app_root/tmp/propane.pid}"
if ! path_is_absolute "$pid_file"; then
  pid_file="$app_root/$pid_file"
fi
mkdir -p "$(dirname "$pid_file")"

if [[ -f "$pid_file" ]]; then
  existing_pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [[ -n "$existing_pid" ]] && kill -0 "$existing_pid" 2>/dev/null; then
    echo "propane: already running with pid $existing_pid (pid file: $pid_file)" >&2
    exit 1
  fi
  rm -f "$pid_file"
fi

is_app_root=0
if [[ -f "$app_root/config/app.plist" ]] && app_root_has_sources "$app_root"; then
  is_app_root=1
fi

# Only a non-checkout root counts as a packaged release. A built checkout also
# has build/arlen, but its app binary may be stale, so it must go through the
# boomhauer prepare step (GitHub issue 150). A macOS source checkout builds with
# the Apple toolchain into .boomhauer/apple/ and build/apple/; packaged releases
# keep the build/ layout on every platform.
app_build_binary="$app_root/.boomhauer/build/boomhauer-app"
framework_server_binary="$framework_root/build/boomhauer"
prefer_packaged_binary=0
if (( is_release_framework_root == 1 && is_checkout_framework_root == 0 )); then
  prefer_packaged_binary=1
fi
if (( is_apple_host == 1 && is_checkout_framework_root == 1 )); then
  app_build_binary="$app_root/.boomhauer/apple/boomhauer-app"
  framework_server_binary="$framework_root/build/apple/boomhauer"
fi

packaged_app_binary=""
if (( prefer_packaged_binary == 1 )) && packaged_app_binary="$(resolve_compiled_binary "$app_build_binary")"; then
  :
else
  packaged_app_binary=""
fi

if [[ -n "$packaged_app_binary" ]]; then
  # ARLEN-BUG-018: packaged releases must prefer the shipped runtime binary,
  # even when the app root no longer looks like a mutable source checkout.
  app_binary="$packaged_app_binary"
elif (( is_app_root == 1 )); then
  if ARLEN_APP_ROOT="$app_root" ARLEN_FRAMEWORK_ROOT="$framework_root" \
      "$framework_root/bin/boomhauer" --no-watch --prepare-only >/dev/null; then
    :
  else
    status=$?
    echo "propane: app prepare step failed; see $app_root/.boomhauer/last_build_error.log" >&2
    exit "$status"
  fi
  if ! app_binary="$(resolve_compiled_binary "$app_build_binary")"; then
    echo "propane: expected compiled server binary at $app_build_binary" >&2
    exit 1
  fi
else
  if (( is_checkout_framework_root == 1 && is_apple_host == 1 )); then
    "$framework_root/bin/build-apple" --with-boomhauer >/dev/null
  elif (( is_checkout_framework_root == 1 )); then
    make -C "$framework_root" boomhauer >/dev/null
  fi
  if ! app_binary="$(resolve_compiled_binary "$framework_server_binary")"; then
    echo "propane: expected compiled server binary at $framework_server_binary" >&2
    exit 1
  fi
fi

if [[ ! -x "$app_binary" ]]; then
  echo "propane: expected compiled server binary at $app_binary" >&2
  exit 1
fi

worker_args=(--env "$environment" --host "$host" --port "$port")
worker_args+=(${worker_passthrough[@]+"${worker_passthrough[@]}"})

export ARLEN_APP_ROOT="$app_root"
export ARLEN_FRAMEWORK_ROOT="$framework_root"
# Workers use this to warn when process-local state (websocket channels) cannot
# reach the other workers.
if (( worker_count > 1 && ${config_rate_limit_enabled:-0} == 1 )); then
  echo "propane: rateLimit.enabled requires one worker because the built-in rate limiter is process-local. Use --workers 1, or disable rateLimit.enabled and enforce the request budget at ingress." >&2
  exit 1
fi
export ARLEN_PROPANE_WORKERS="$worker_count"
export ARLEN_LISTEN_BACKLOG="$listen_backlog"
export ARLEN_CONNECTION_TIMEOUT_SECONDS="$connection_timeout_seconds"
export ARLEN_ENABLE_REUSEPORT="$enable_reuse_port"
export ARLEN_CLUSTER_ENABLED="$cluster_enabled"
export ARLEN_CLUSTER_NAME="$cluster_name"
export ARLEN_CLUSTER_NODE_ID="$cluster_node_id"
export ARLEN_CLUSTER_EXPECTED_NODES="$cluster_expected_nodes"

lifecycle_log_file="${ARLEN_PROPANE_LIFECYCLE_LOG:-}"
if [[ -n "$lifecycle_log_file" ]]; then
  if ! path_is_absolute "$lifecycle_log_file"; then
    lifecycle_log_file="$app_root/$lifecycle_log_file"
  fi
  mkdir -p "$(dirname "$lifecycle_log_file")"
  : > "$lifecycle_log_file"
fi

emit_lifecycle_event() {
  local event="$1"
  shift
  local line="propane:lifecycle event=$event manager_pid=$$"
  local kv
  for kv in "$@"; do
    line="$line $kv"
  done
  echo "$line"
  if [[ -n "$lifecycle_log_file" ]]; then
    echo "$line" >> "$lifecycle_log_file"
  fi
}

describe_wait_status() {
  local status="$1"
  if (( status >= 128 )); then
    echo "signal_$((status - 128))"
  elif (( status == 0 )); then
    echo "exit_0"
  else
    echo "exit_$status"
  fi
}

if [[ "${config_storage_unshared:-0}" == "1" && "$worker_count" -gt 1 ]]; then
  echo "propane: warning: storageModule.persistence.enabled = NO with workerCount=$worker_count; each worker keeps its own storage catalog, so most downloads and variant jobs will not find their objects. Enable storage persistence or run one worker." >&2
fi
echo "propane: starting with propane accessories workerCount=$worker_count gracefulShutdownSeconds=$graceful_shutdown_seconds respawnDelayMs=$respawn_delay_ms reloadOverlapSeconds=$reload_overlap_seconds startupFailureLimit=$startup_failure_limit respawnBackoffMaxMs=$respawn_backoff_max_ms"
echo "propane: runtime host=$host port=$port listenBacklog=$listen_backlog connectionTimeoutSeconds=$connection_timeout_seconds enableReusePort=$enable_reuse_port"
echo "propane: cluster enabled=$cluster_enabled name=$cluster_name nodeID=$cluster_node_id expectedNodes=$cluster_expected_nodes"
if (( job_worker_count > 0 )); then
  echo "propane: async workers count=$job_worker_count respawnDelayMs=$job_worker_respawn_delay_ms"
fi
echo "propane: fd pressure warnPercent=$worker_fd_warn_percent criticalPercent=$worker_fd_critical_percent retirePercent=$worker_fd_retire_percent retireCount=$worker_fd_retire_count checkSeconds=$worker_fd_check_seconds"

echo "$$" > "$pid_file"
emit_lifecycle_event "manager_started" \
  "worker_count=$worker_count" \
  "async_worker_count=$job_worker_count" \
  "host=$host" \
  "port=$port" \
  "env=$environment"

sleep_ms() {
  local ms="$1"
  if (( ms <= 0 )); then
    return
  fi
  local whole="$((ms / 1000))"
  local frac="$((ms % 1000))"
  local duration
  printf -v duration '%d.%03d' "$whole" "$frac"
  sleep "$duration"
}

# Sleeps in short slices so a TERM/INT during a long respawn backoff still
# stops propane promptly.
sleep_ms_interruptible() {
  local remaining="$1"
  while (( remaining > 0 && shutting_down == 0 )); do
    local slice=200
    if (( remaining < slice )); then
      slice="$remaining"
    fi
    sleep_ms "$slice"
    remaining=$((remaining - slice))
  done
}

# Startup failures. Each worker gets ARLEN_STARTUP_FAILURE_FILE; a worker that
# cannot start (a module that fails to load, invalid security config) writes
# its error there and exits, instead of printing it. propane prints each
# distinct error once, backs off exponentially from the respawn delay up to
# respawnBackoffMaxMs, and exits non-zero after startupFailureLimit
# consecutive startup failures (of any error) so the service manager sees a
# failed unit. A worker exit that is not a startup failure resets the streak.
startup_failure_dir="$(mktemp -d "${TMPDIR:-/tmp}/propane-startup.XXXXXX")"
startup_failure_seq=0
startup_failure_pids=()
startup_failure_files=()
http_startup_streak=0
http_startup_same=0
http_startup_last=""
async_startup_streak=0
async_startup_same=0
async_startup_last=""
startup_failure_give_up=0
next_respawn_delay_ms=0

# Sets new_failure_file. Runs in the calling shell (never in $(...)), so the
# sequence number advances and every worker gets its own file.
new_startup_failure_file() {
  startup_failure_seq=$((startup_failure_seq + 1))
  new_failure_file="$startup_failure_dir/worker-$startup_failure_seq"
  : > "$new_failure_file"
}

remember_startup_failure_file() {
  startup_failure_pids+=("$1")
  startup_failure_files+=("$2")
}

# Sets taken_startup_failure to the recorded startup error for a pid (empty
# when the worker started) and forgets its file.
take_startup_failure() {
  local pid="$1"
  local idx
  local keep_pids=()
  local keep_files=()
  taken_startup_failure=""
  for idx in ${!startup_failure_pids[@]}; do
    if [[ "${startup_failure_pids[$idx]}" == "$pid" ]]; then
      local file="${startup_failure_files[$idx]}"
      if [[ -s "$file" ]]; then
        taken_startup_failure="$(head -c 2000 "$file" | tr '\r\n' '  ')"
      fi
      rm -f "$file"
    else
      keep_pids+=("${startup_failure_pids[$idx]}")
      keep_files+=("${startup_failure_files[$idx]}")
    fi
  done
  startup_failure_pids=(${keep_pids[@]+"${keep_pids[@]}"})
  startup_failure_files=(${keep_files[@]+"${keep_files[@]}"})
}

# role: http or async. Sets next_respawn_delay_ms and startup_failure_give_up.
note_worker_exit() {
  local role="$1"
  local text="$2"
  local base_delay="$3"
  local label="worker"
  if [[ "$role" == "async" ]]; then
    label="async worker"
  fi
  local streak_var="${role}_startup_streak"
  local same_var="${role}_startup_same"
  local last_var="${role}_startup_last"
  if [[ -z "$text" ]]; then
    printf -v "$streak_var" '%d' 0
    printf -v "$same_var" '%d' 0
    printf -v "$last_var" '%s' ""
    next_respawn_delay_ms="$base_delay"
    return
  fi
  local streak=$(( ${!streak_var} + 1 ))
  local same=1
  if [[ "$text" == "${!last_var}" ]]; then
    same=$(( ${!same_var} + 1 ))
  fi
  printf -v "$streak_var" '%d' "$streak"
  printf -v "$same_var" '%d' "$same"
  printf -v "$last_var" '%s' "$text"
  if (( same == 1 )); then
    echo "propane: $label startup failed: $text"
  else
    echo "propane: $label startup failed (same error) x$same"
  fi
  local delay="$base_delay"
  if (( delay < 100 )); then
    delay=100
  fi
  local step
  for ((step = 1; step < streak; step++)); do
    delay=$((delay * 2))
    if (( respawn_backoff_max_ms > 0 && delay >= respawn_backoff_max_ms )); then
      delay="$respawn_backoff_max_ms"
      break
    fi
  done
  next_respawn_delay_ms="$delay"
  emit_lifecycle_event "${role}_worker_startup_failed" "role=$role" "consecutive_failures=$streak" "same_error_count=$same" "next_respawn_delay_ms=$delay"
  if (( startup_failure_limit > 0 && streak >= startup_failure_limit )); then
    startup_failure_give_up=1
  fi
}

# FD pressure: Linux reads /proc. Elsewhere (macOS) lsof lists the worker's
# numeric descriptors, and the soft limit is propane's own, which workers
# inherit and do not change.
fd_probe="none"
if [[ -d /proc/self/fd ]]; then
  fd_probe="proc"
elif command -v lsof >/dev/null 2>&1; then
  fd_probe="lsof"
fi

worker_fd_count() {
  local pid="$1"
  case "$fd_probe" in
    proc)
      if [[ ! -d "/proc/$pid/fd" ]]; then
        echo "-1"
        return
      fi
      # A glob forks nothing; the manager loop is single-threaded (#222).
      local fds=("/proc/$pid/fd"/*)
      if [[ -e "${fds[0]}" || -L "${fds[0]}" ]]; then
        echo "${#fds[@]}"
      else
        echo "0"
      fi
      ;;
    lsof)
      # A worker can exit after kill -0 and before lsof runs. Treat that as
      # unavailable so pipefail/errexit cannot abort the manager before it
      # reaps the worker and applies startup-failure backoff.
      local listing
      if ! listing="$(lsof -nP -a -p "$pid" -d 0-999999 -F f 2>/dev/null)"; then
        echo "-1"
        return
      fi
      printf '%s\n' "$listing" | awk '/^f/ {n++} END {print n + 0}'
      ;;
    *)
      echo "-1"
      ;;
  esac
}

worker_fd_soft_limit() {
  local pid="$1"
  if [[ "$fd_probe" == "lsof" ]]; then
    local limit
    limit="$(ulimit -n)"
    if is_uint "$limit"; then
      echo "$limit"
    else
      echo "0"
    fi
    return
  fi
  if [[ ! -r "/proc/$pid/limits" ]]; then
    echo "0"
    return
  fi
  # The worker can exit between the readability check and awk opening limits.
  # An unavailable sample must not trigger errexit before worker reaping.
  local sampled_limit
  if ! sampled_limit="$(awk '$1 == "Max" && $2 == "open" && $3 == "files" {print $4; found=1} END {if (!found) print 0}' "/proc/$pid/limits" 2>/dev/null)"; then
    echo "0"
    return
  fi
  printf '%s\n' "$sampled_limit"
}

worker_fd_targets() {
  local pid="$1"
  case "$fd_probe" in
    proc)
      # One process for every target instead of one readlink per descriptor
      # (#222); fall back to readlink where find lacks -printf.
      if ! find "/proc/$pid/fd" -mindepth 1 -maxdepth 1 -type l -printf '%l\n' 2>/dev/null; then
        local fd
        for fd in "/proc/$pid/fd"/*; do
          readlink "$fd" 2>/dev/null || true
        done
      fi
      ;;
    lsof)
      lsof -nP -a -p "$pid" -d 0-999999 -F n 2>/dev/null | sed -n 's/^n//p'
      ;;
  esac
}

worker_fd_top_targets() {
  local pid="$1"
  if [[ "$fd_probe" == "proc" && ! -d "/proc/$pid/fd" ]]; then
    echo ""
    return
  fi
  local line
  local out=""
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line// /_}"
    if [[ -n "$line" ]]; then
      if [[ -n "$out" ]]; then
        out="$out,$line"
      else
        out="$line"
      fi
    fi
  done < <(worker_fd_targets "$pid" | sort | uniq -c | sort -nr | head -5)
  echo "$out"
}

remove_worker_pid() {
  local retired_pid="$1"
  local survivors=()
  local pid
  for pid in ${workers[@]+"${workers[@]}"}; do
    if [[ "$pid" != "$retired_pid" ]]; then
      survivors+=("$pid")
    fi
  done
  workers=(${survivors[@]+"${survivors[@]}"})
}

check_worker_fd_pressure() {
  if [[ "$fd_probe" == "none" ]]; then
    return
  fi

  local retire_pids=()
  local pid
  for pid in ${workers[@]+"${workers[@]}"}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      continue
    fi
    local fd_count soft_limit usage_percent remaining top_targets severity should_retire reason
    fd_count="$(worker_fd_count "$pid")"
    soft_limit="$(worker_fd_soft_limit "$pid")"
    if ! is_uint "$fd_count" || (( fd_count < 0 )); then
      continue
    fi
    if ! is_uint "$soft_limit" || (( soft_limit <= 0 )); then
      usage_percent=0
      remaining=-1
    else
      usage_percent="$((fd_count * 100 / soft_limit))"
      remaining="$((soft_limit - fd_count))"
    fi
    top_targets=""
    severity=""
    if (( worker_fd_critical_percent > 0 && usage_percent >= worker_fd_critical_percent )); then
      severity="critical"
    elif (( worker_fd_warn_percent > 0 && usage_percent >= worker_fd_warn_percent )); then
      severity="warning"
    fi
    should_retire=0
    reason=""
    if (( worker_fd_retire_count > 0 && fd_count >= worker_fd_retire_count )); then
      should_retire=1
      reason="fd_count_threshold"
    elif (( worker_fd_retire_percent > 0 && usage_percent >= worker_fd_retire_percent )); then
      should_retire=1
      reason="fd_percent_threshold"
    fi
    # The target breakdown is only for the events below, and it scales with
    # the worker's descriptor count, so skip it for healthy workers (#222).
    if [[ -n "$severity" ]] || (( should_retire == 1 )); then
      top_targets="$(worker_fd_top_targets "$pid")"
    fi
    if [[ -n "$severity" ]]; then
      emit_lifecycle_event "worker_fd_pressure_${severity}" \
        "role=http" \
        "pid=$pid" \
        "fd_count=$fd_count" \
        "fd_soft_limit=$soft_limit" \
        "fd_usage_percent=$usage_percent" \
        "fd_remaining=$remaining" \
        "top_fd_targets=$top_targets"
    fi

    if (( should_retire == 1 )); then
      emit_lifecycle_event "worker_fd_pressure_retire_requested" \
        "role=http" \
        "pid=$pid" \
        "reason=$reason" \
        "fd_count=$fd_count" \
        "fd_soft_limit=$soft_limit" \
        "fd_usage_percent=$usage_percent" \
        "fd_remaining=$remaining" \
        "top_fd_targets=$top_targets"
      retire_pids+=("$pid")
    fi
  done

  for pid in ${retire_pids[@]+"${retire_pids[@]}"}; do
    remove_worker_pid "$pid"
    terminate_pid_list "http_worker" "fd_pressure_retire" "$pid"
    if (( no_respawn == 0 && once_mode == 0 && shutting_down == 0 )); then
      sleep_ms "$respawn_delay_ms"
      spawn_worker "respawn_after_fd_pressure"
    fi
  done
}

spawn_worker() {
  local start_reason="${1:-boot}"
  new_startup_failure_file
  local failure_file="$new_failure_file"
  ARLEN_STARTUP_FAILURE_FILE="$failure_file" "$app_binary" ${worker_args[@]+"${worker_args[@]}"} &
  local pid=$!
  remember_startup_failure_file "$pid" "$failure_file"
  workers+=("$pid")
  echo "propane: worker started pid=$pid"
  emit_lifecycle_event "worker_started" "role=http" "pid=$pid" "reason=$start_reason"
}

spawn_job_worker() {
  local start_reason="${1:-boot}"
  if (( job_worker_count < 1 )) || [[ -z "$job_worker_command" ]]; then
    return
  fi
  new_startup_failure_file
  local failure_file="$new_failure_file"
  ARLEN_STARTUP_FAILURE_FILE="$failure_file" bash -lc "$job_worker_command" &
  local pid=$!
  remember_startup_failure_file "$pid" "$failure_file"
  job_workers+=("$pid")
  echo "propane: async worker started pid=$pid"
  emit_lifecycle_event "async_worker_started" "role=async" "pid=$pid" "reason=$start_reason"
}

terminate_pid_list() {
  local role="$1"
  local stop_reason="$2"
  shift 2
  local candidates=("$@")
  if (( ${#candidates[@]} == 0 )); then
    return
  fi

  local alive=()
  local pid
  for pid in ${candidates[@]+"${candidates[@]}"}; do
    if kill -0 "$pid" 2>/dev/null; then
      emit_lifecycle_event "${role}_stop_requested" "role=$role" "pid=$pid" "signal=TERM" "reason=$stop_reason"
      kill -TERM "$pid" 2>/dev/null || true
      alive+=("$pid")
    fi
  done

  local max_ticks="$((graceful_shutdown_seconds * 10))"
  if (( max_ticks < 1 )); then
    max_ticks=1
  fi

  local tick
  for ((tick = 0; tick < max_ticks && ${#alive[@]} > 0; tick++)); do
    local remaining=()
    for pid in ${alive[@]+"${alive[@]}"}; do
      if kill -0 "$pid" 2>/dev/null; then
        remaining+=("$pid")
      else
        set +e
        wait "$pid" 2>/dev/null
        local status=$?
        set -e
        local exit_reason
        exit_reason="$(describe_wait_status "$status")"
        emit_lifecycle_event "${role}_stopped" "role=$role" "pid=$pid" "status=$status" "exit_reason=$exit_reason" "reason=$stop_reason"
      fi
    done
    alive=(${remaining[@]+"${remaining[@]}"})
    if (( ${#alive[@]} > 0 )); then
      sleep 0.1
    fi
  done

  for pid in ${alive[@]+"${alive[@]}"}; do
    emit_lifecycle_event "${role}_stop_requested" "role=$role" "pid=$pid" "signal=KILL" "reason=${stop_reason}_grace_timeout"
    kill -KILL "$pid" 2>/dev/null || true
  done
  for pid in ${alive[@]+"${alive[@]}"}; do
    set +e
    wait "$pid" 2>/dev/null
    local status=$?
    set -e
    local exit_reason
    exit_reason="$(describe_wait_status "$status")"
    emit_lifecycle_event "${role}_stopped" "role=$role" "pid=$pid" "status=$status" "exit_reason=$exit_reason" "reason=${stop_reason}_grace_timeout"
  done
}

workers=()
job_workers=()
shutting_down=0
reload_requested=0
manager_exit=0
shutdown_reason="manager_exit"
reload_generation=0
last_fd_pressure_check=0

on_term() {
  local signal_name="${1:-TERM}"
  local normalized
  normalized="$(printf '%s' "$signal_name" | tr '[:upper:]' '[:lower:]')"
  if (( shutting_down == 1 )); then
    return
  fi
  shutdown_reason="signal_${normalized}"
  emit_lifecycle_event "manager_shutdown_requested" "signal=$signal_name" "reason=$shutdown_reason"
  shutting_down=1
}

on_hup() {
  if (( shutting_down == 1 )); then
    return
  fi
  emit_lifecycle_event "manager_reload_requested" "signal=HUP"
  reload_requested=1
}

cleanup_and_exit() {
  local code="$1"
  emit_lifecycle_event "manager_stopping" "reason=$shutdown_reason" "exit_code=$code"
  terminate_pid_list "http_worker" "$shutdown_reason" ${workers[@]+"${workers[@]}"}
  terminate_pid_list "async_worker" "$shutdown_reason" ${job_workers[@]+"${job_workers[@]}"}
  rm -f "$pid_file"
  rm -rf "$startup_failure_dir"
  emit_lifecycle_event "manager_stopped" "reason=$shutdown_reason" "exit_code=$code"
  exit "$code"
}

trap 'on_term INT' INT
trap 'on_term TERM' TERM
trap on_hup HUP

if (( print_routes == 1 )); then
  workers=()
  rm -f "$pid_file"
  exec "$app_binary" ${worker_args[@]+"${worker_args[@]}"}
fi

for ((idx = 0; idx < worker_count; idx++)); do
  spawn_worker "boot"
done
for ((idx = 0; idx < job_worker_count; idx++)); do
  spawn_job_worker "boot"
done

while (( shutting_down == 0 )); do
  now_seconds="$(date +%s)"
  if (( once_mode == 0 )) && (( now_seconds - last_fd_pressure_check >= worker_fd_check_seconds )); then
    check_worker_fd_pressure
    last_fd_pressure_check="$now_seconds"
  fi

  if (( reload_requested == 1 )); then
    reload_generation=$((reload_generation + 1))
    old_workers=(${workers[@]+"${workers[@]}"})
    old_job_workers=(${job_workers[@]+"${job_workers[@]}"})
    workers=()
    job_workers=()
    echo "propane: reload requested; starting replacement workers"
    emit_lifecycle_event "manager_reload_started" "generation=$reload_generation" "worker_count=$worker_count" "async_worker_count=$job_worker_count"
    for ((idx = 0; idx < worker_count; idx++)); do
      spawn_worker "reload_generation_${reload_generation}"
    done
    for ((idx = 0; idx < job_worker_count; idx++)); do
      spawn_job_worker "reload_generation_${reload_generation}"
    done
    if (( reload_overlap_seconds > 0 )); then
      sleep "$reload_overlap_seconds"
    fi
    terminate_pid_list "http_worker" "reload_retire_generation_${reload_generation}" ${old_workers[@]+"${old_workers[@]}"}
    terminate_pid_list "async_worker" "reload_retire_generation_${reload_generation}" ${old_job_workers[@]+"${old_job_workers[@]}"}
    emit_lifecycle_event "manager_reload_completed" "generation=$reload_generation" "active_workers=${#workers[@]}" "active_async_workers=${#job_workers[@]}"
    reload_requested=0
  fi

  dead=()
  for pid in ${workers[@]+"${workers[@]}"}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      set +e
      wait "$pid"
      status=$?
      set -e
      dead+=("$pid:$status")
    fi
  done

  if (( ${#dead[@]} > 0 )); then
    survivors=()
    for pid in ${workers[@]+"${workers[@]}"}; do
      is_dead=0
      for pair in ${dead[@]+"${dead[@]}"}; do
        dead_pid="${pair%%:*}"
        if [[ "$pid" == "$dead_pid" ]]; then
          is_dead=1
          break
        fi
      done
      if (( is_dead == 0 )); then
        survivors+=("$pid")
      fi
    done
    workers=(${survivors[@]+"${survivors[@]}"})

    dead_delays=()
    for pair in ${dead[@]+"${dead[@]}"}; do
      dead_pid="${pair%%:*}"
      dead_status="${pair##*:}"
      echo "propane: worker exited pid=$dead_pid status=$dead_status"
      take_startup_failure "$dead_pid"
      note_worker_exit "http" "$taken_startup_failure" "$respawn_delay_ms"
      dead_delays+=("$next_respawn_delay_ms")
      dead_exit_reason="$(describe_wait_status "$dead_status")"
      restart_action="none"
      if (( no_respawn == 0 && once_mode == 0 && shutting_down == 0 )); then
        restart_action="respawn"
      fi
      emit_lifecycle_event "worker_exited" "role=http" "pid=$dead_pid" "status=$dead_status" "exit_reason=$dead_exit_reason" "restart_action=$restart_action"
    done

    if (( once_mode == 1 )); then
      manager_exit="${dead[0]##*:}"
      shutdown_reason="once_mode_worker_exit"
      emit_lifecycle_event "manager_shutdown_requested" "signal=internal" "reason=$shutdown_reason" "exit_status=$manager_exit"
      shutting_down=1
      continue
    fi

    if (( startup_failure_give_up == 1 )); then
      manager_exit=3
      shutdown_reason="worker_startup_failed"
      echo "propane: giving up after $http_startup_streak consecutive worker startup failures; last: $http_startup_last" >&2
      emit_lifecycle_event "manager_shutdown_requested" "signal=internal" "reason=$shutdown_reason" "exit_status=$manager_exit"
      shutting_down=1
      continue
    fi

    if (( no_respawn == 0 )); then
      for delay in ${dead_delays[@]+"${dead_delays[@]}"}; do
        sleep_ms_interruptible "$delay"
        if (( shutting_down == 1 )); then
          break
        fi
        spawn_worker "respawn_after_exit"
      done
    elif (( ${#workers[@]} == 0 )); then
      manager_exit="${dead[0]##*:}"
      shutdown_reason="workers_exhausted_no_respawn"
      emit_lifecycle_event "manager_shutdown_requested" "signal=internal" "reason=$shutdown_reason" "exit_status=$manager_exit"
      shutting_down=1
      continue
    fi
  fi

  job_dead=()
  for pid in ${job_workers[@]+"${job_workers[@]}"}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      set +e
      wait "$pid"
      status=$?
      set -e
      job_dead+=("$pid:$status")
    fi
  done

  if (( ${#job_dead[@]} > 0 )); then
    job_survivors=()
    for pid in ${job_workers[@]+"${job_workers[@]}"}; do
      is_dead=0
      for pair in ${job_dead[@]+"${job_dead[@]}"}; do
        dead_pid="${pair%%:*}"
        if [[ "$pid" == "$dead_pid" ]]; then
          is_dead=1
          break
        fi
      done
      if (( is_dead == 0 )); then
        job_survivors+=("$pid")
      fi
    done
    job_workers=(${job_survivors[@]+"${job_survivors[@]}"})

    job_dead_delays=()
    for pair in ${job_dead[@]+"${job_dead[@]}"}; do
      dead_pid="${pair%%:*}"
      dead_status="${pair##*:}"
      echo "propane: async worker exited pid=$dead_pid status=$dead_status"
      take_startup_failure "$dead_pid"
      note_worker_exit "async" "$taken_startup_failure" "$job_worker_respawn_delay_ms"
      job_dead_delays+=("$next_respawn_delay_ms")
      dead_exit_reason="$(describe_wait_status "$dead_status")"
      restart_action="none"
      if (( no_respawn == 0 && shutting_down == 0 )); then
        restart_action="respawn"
      fi
      emit_lifecycle_event "async_worker_exited" "role=async" "pid=$dead_pid" "status=$dead_status" "exit_reason=$dead_exit_reason" "restart_action=$restart_action"
    done

    if (( startup_failure_give_up == 1 )); then
      manager_exit=3
      shutdown_reason="async_worker_startup_failed"
      echo "propane: giving up after $async_startup_streak consecutive async worker startup failures; last: $async_startup_last" >&2
      emit_lifecycle_event "manager_shutdown_requested" "signal=internal" "reason=$shutdown_reason" "exit_status=$manager_exit"
      shutting_down=1
      continue
    fi

    if (( no_respawn == 0 )); then
      for delay in ${job_dead_delays[@]+"${job_dead_delays[@]}"}; do
        sleep_ms_interruptible "$delay"
        if (( shutting_down == 1 )); then
          break
        fi
        spawn_job_worker "respawn_after_exit"
      done
    fi
  fi

  sleep 0.2
done

cleanup_and_exit "$manager_exit"
