#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "${1:-}" == "doctor" ]]; then
  shift
  if [[ ! -x "$repo_root/bin/arlen-doctor" ]]; then
    echo "arlen doctor: missing bootstrap script at $repo_root/bin/arlen-doctor" >&2
    exit 1
  fi
  exec "$repo_root/bin/arlen-doctor" "$@"
fi

build_platform="${ARLEN_BUILD_PLATFORM:-auto}"
if [[ "$build_platform" == "auto" && "$(uname -s)" == "Darwin" ]]; then
  build_platform="apple"
fi

if [[ "$build_platform" == "apple" ]]; then
  "$repo_root/bin/build-apple" >/dev/null
  exec "$repo_root/build/apple/arlen" "$@"
fi

if [[ "$(uname -s)" == Linux ]]; then
  source "$repo_root/tools/source_gnustep_env.sh" >/dev/null || exit 1
fi

# A release archive without build/obj (Windows) is trusted while its
# build/.release-prebuilt still matches; otherwise make keeps arlen current.
arlen_binary="$repo_root/build/arlen"
[[ -f "$repo_root/build/arlen.exe" ]] && arlen_binary="$repo_root/build/arlen.exe"
source "$repo_root/tools/release_prebuilt.sh"
if ! aln_release_prebuilt_is_current "$repo_root" "$arlen_binary"; then
  make -C "$repo_root" arlen >/dev/null
fi
exec "$repo_root/build/arlen" "$@"
