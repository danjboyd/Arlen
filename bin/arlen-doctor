#!/usr/bin/env bash
set -euo pipefail

print_usage() {
  cat <<'USAGE'
Usage: arlen doctor [--env <name>] [--json]

Runs bootstrap environment checks without requiring an Arlen build.
USAGE
}

environment="development"
as_json=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --env)
      [[ $# -ge 2 ]] || { echo "arlen doctor: --env requires a value" >&2; exit 2; }
      environment="$2"
      shift 2
      ;;
    --json)
      as_json=1
      shift
      ;;
    --help|-h)
      print_usage
      exit 0
      ;;
    *)
      echo "arlen doctor: unknown option $1" >&2
      exit 2
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
app_root="$PWD"

# shellcheck source=tools/platform.sh
source "$repo_root/tools/platform.sh"

to_absolute_path() {
  local raw="$1"
  if [[ -z "$raw" ]]; then
    return 1
  fi
  if aln_platform_is_msys && command -v cygpath >/dev/null 2>&1; then
    cygpath -au "$raw"
  elif [[ "$raw" = /* ]]; then
    printf '%s\n' "$raw"
  else
    printf '%s\n' "$app_root/$raw"
  fi
}

is_framework_root() {
  local candidate="$1"
  [[ -f "$candidate/GNUmakefile" && -d "$candidate/src/Arlen" ]]
}

find_framework_root() {
  local candidate="$1"
  while [[ -n "$candidate" ]]; do
    if is_framework_root "$candidate"; then
      echo "$candidate"
      return 0
    fi
    local parent
    parent="$(dirname "$candidate")"
    [[ "$parent" != "$candidate" ]] || break
    candidate="$parent"
  done
  return 1
}

pass_count=0
warn_count=0
fail_count=0
checks=()

add_check() {
  local check_id="$1"
  local status="$2"
  local message="$3"
  local hint="${4:-}"
  checks+=("$check_id"$'\t'"$status"$'\t'"$message"$'\t'"$hint")
  case "$status" in
    pass) pass_count=$((pass_count + 1)) ;;
    warn) warn_count=$((warn_count + 1)) ;;
    fail) fail_count=$((fail_count + 1)) ;;
  esac
}

check_command() {
  local command_name="$1"
  local level="$2"
  local missing_hint="$3"
  if command -v "$command_name" >/dev/null 2>&1; then
    add_check "tool_$command_name" "pass" "$command_name found at $(command -v "$command_name")"
  else
    add_check "tool_$command_name" "$level" "$command_name not found on PATH" "$missing_hint"
  fi
}

framework_root=""
framework_override="${ARLEN_FRAMEWORK_ROOT:-}"
if [[ -n "$framework_override" ]]; then
  candidate="$(to_absolute_path "$framework_override")"
  if is_framework_root "$candidate"; then
    framework_root="$candidate"
    add_check "framework_root" "pass" "framework root: $framework_root"
  else
    add_check "framework_root" "fail" "ARLEN_FRAMEWORK_ROOT is not valid: $framework_override" \
      "Unset ARLEN_FRAMEWORK_ROOT or point it to an Arlen checkout with GNUmakefile + src/Arlen."
  fi
else
  if is_framework_root "$repo_root"; then
    framework_root="$repo_root"
  elif resolved_root="$(find_framework_root "$app_root" 2>/dev/null)"; then
    framework_root="$resolved_root"
  fi

  if [[ -n "$framework_root" ]]; then
    add_check "framework_root" "pass" "framework root: $framework_root"
  else
    add_check "framework_root" "fail" "could not resolve framework root" \
      "Run inside an Arlen checkout or set ARLEN_FRAMEWORK_ROOT."
  fi
fi

app_config_path="$app_root/config/app.plist"
if [[ -f "$app_config_path" ]]; then
  add_check "app_root" "pass" "app config found: $app_config_path"
else
  add_check "app_root" "warn" "app config not found at $app_config_path" \
    "Run 'arlen new <AppName>' if you are bootstrapping a new app."
fi

# The top-level `version = "1.2.3";` of a module.plist (dependency constraints
# such as ">= 1.0.0" don't start with a digit, so they never match).
module_manifest_version() {
  sed -n -E 's/^[[:space:]]*version[[:space:]]*=[[:space:]]*"([0-9][0-9.]*)"[[:space:]]*;.*/\1/p' "$1" | head -n 1
}

# Succeeds when dotted numeric version $1 is lower than $2.
module_version_lt() {
  local IFS=.
  local -a left=($1) right=($2)
  local idx count=${#left[@]}
  (( ${#right[@]} > count )) && count=${#right[@]}
  for (( idx = 0; idx < count; idx++ )); do
    local l=$((10#${left[idx]:-0})) r=$((10#${right[idx]:-0}))
    (( l < r )) && return 0
    (( l > r )) && return 1
  done
  return 1
}

# Vendored modules compile from the app's copy, so a framework upgrade alone
# leaves them at their old version until `arlen module upgrade`.
if [[ -f "$app_config_path" && -n "$framework_root" && -d "$app_root/modules" ]]; then
  vendored_module_count=0
  outdated_module_count=0
  for vendored_manifest in "$app_root"/modules/*/module.plist; do
    [[ -f "$vendored_manifest" ]] || continue
    module_dir="$(dirname "$vendored_manifest")"
    module_id="$(basename "$module_dir")"
    framework_manifest="$framework_root/modules/$module_id/module.plist"
    [[ -f "$framework_manifest" ]] || continue
    [[ "$(cd "$module_dir" && pwd -P)" == "$(cd "$(dirname "$framework_manifest")" && pwd -P)" ]] && continue
    vendored_module_count=$((vendored_module_count + 1))
    installed_version="$(module_manifest_version "$vendored_manifest")"
    available_version="$(module_manifest_version "$framework_manifest")"
    [[ -n "$installed_version" && -n "$available_version" ]] || continue
    if module_version_lt "$installed_version" "$available_version"; then
      outdated_module_count=$((outdated_module_count + 1))
      add_check "module_outdated" "warn" \
        "module $module_id is $installed_version in this app; the framework has $available_version" \
        "run \`arlen module upgrade $module_id\`, then \`arlen module migrate\`, then rebuild (framework copy: $(dirname "$framework_manifest"))"
    fi
  done
  if (( vendored_module_count > 0 && outdated_module_count == 0 )); then
    add_check "module_outdated" "pass" "$vendored_module_count vendored module(s) are at the framework's versions"
  fi
fi

phase39_config_blob() {
  if [[ -f "$app_config_path" ]]; then
    sed 's,//.*,,' "$app_config_path"
  fi
  local env_config="$app_root/config/environments/$environment.plist"
  if [[ -f "$env_config" ]]; then
    sed 's,//.*,,' "$env_config"
  fi
}

phase39_last_numeric_assignment() {
  local key="$1"
  phase39_config_blob | sed -nE "s/.*${key}[[:space:]]*=[[:space:]]*([0-9]+)[[:space:]]*;.*/\\1/p" | tail -n 1
}

phase39_has_nonempty_assignment() {
  local key="$1"
  phase39_config_blob | sed -nE "s/.*${key}[[:space:]]*=[[:space:]]*\"([^\"]+)\"[[:space:]]*;.*/\\1/p" | grep -q '.'
}

phase39_environment_kind="$(printf '%s' "$environment" | tr '[:upper:]' '[:lower:]')"
if [[ "$phase39_environment_kind" != "development" && "$phase39_environment_kind" != "test" && -f "$app_config_path" ]]; then
  phase39_worker_count="${ARLEN_PROPANE_WORKERS:-}"
  if [[ ! "$phase39_worker_count" =~ ^[0-9]+$ ]]; then
    phase39_worker_count="$(phase39_last_numeric_assignment "workerCount")"
  fi
  if [[ ! "$phase39_worker_count" =~ ^[0-9]+$ ]]; then
    phase39_worker_count=4
  fi

  phase39_has_durable_state=0
  if phase39_config_blob | grep -Eq 'durable[[:space:]]*=[[:space:]]*(YES|1|true)[[:space:]]*;'; then
    phase39_has_durable_state=1
  fi
  phase39_state_durable="$(printf '%s' "${ARLEN_STATE_DURABLE:-}" | tr '[:upper:]' '[:lower:]')"
  if [[ "$phase39_state_durable" =~ ^(1|yes|true)$ ]]; then
    phase39_has_durable_state=1
  fi

  if (( phase39_worker_count > 1 && phase39_has_durable_state == 0 )); then
    add_check "multi_worker_state" "warn" \
      "$environment uses $phase39_worker_count propane workers without declared durable app state" \
      "Each propane worker has isolated process-local memory. Set state.durable=YES only after verifying request-spanning app state is shared; a database URL alone is insufficient."
  else
    add_check "multi_worker_state" "pass" \
      "multi-worker state contract is quiet for $environment workerCount=$phase39_worker_count" \
      "Warnings are quiet when workerCount <= 1 or state.durable=YES."
  fi

  phase39_operability_restricted=""
  if [[ -n "${ARLEN_OPERABILITY_TOKEN:-}" ]] || phase39_has_nonempty_assignment "operabilityToken"; then
    phase39_operability_restricted="bearer token"
  fi
  phase39_operability_loopback="$(printf '%s' "${ARLEN_OPERABILITY_LOOPBACK_ONLY:-}" | tr '[:upper:]' '[:lower:]')"
  if [[ "$phase39_operability_loopback" =~ ^(1|yes|true)$ ]] ||
     phase39_config_blob | grep -Eq 'operabilityLoopbackOnly[[:space:]]*=[[:space:]]*(YES|1|true)[[:space:]]*;'; then
    phase39_operability_restricted="${phase39_operability_restricted:+$phase39_operability_restricted, }loopback only"
  fi
  if [[ -n "$phase39_operability_restricted" ]]; then
    add_check "operability_endpoints" "pass" \
      "/metrics and /clusterz are restricted ($phase39_operability_restricted)"
  else
    phase39_operability_anonymous="$(printf '%s' "${ARLEN_OPERABILITY_ANONYMOUS:-}" | tr '[:upper:]' '[:lower:]')"
    if [[ "$phase39_operability_anonymous" =~ ^(1|yes|true)$ ]] ||
       phase39_config_blob | grep -Eq 'operabilityAnonymous[[:space:]]*=[[:space:]]*(YES|1|true)[[:space:]]*;'; then
      add_check "operability_endpoints" "warn" \
        "/metrics and /clusterz answer anonymous requests (they expose counters, hostname and worker layout)" \
        "Set observability.operabilityToken (or ARLEN_OPERABILITY_TOKEN) to require a bearer token, or observability.operabilityLoopbackOnly = YES, or block both paths at the reverse proxy."
    else
      add_check "operability_endpoints" "warn" \
        "/metrics and /clusterz are disabled (they answer 404 in production until access is configured)" \
        "To scrape them, set observability.operabilityToken (or ARLEN_OPERABILITY_TOKEN) or observability.operabilityLoopbackOnly = YES; observability.operabilityAnonymous = YES restores anonymous access."
    fi
  fi
fi

matrix_path="$repo_root/docs/TOOLCHAIN_MATRIX.md"
if [[ -f "$matrix_path" ]]; then
  add_check "toolchain_matrix" "pass" "known-good matrix available: docs/TOOLCHAIN_MATRIX.md"
else
  add_check "toolchain_matrix" "warn" "known-good matrix missing: docs/TOOLCHAIN_MATRIX.md" \
    "Add and maintain docs/TOOLCHAIN_MATRIX.md for onboarding guidance."
fi

if aln_platform_is_macos; then
  add_check "platform" "pass" "platform: macOS Apple runtime path"
  check_command "xcrun" "fail" "Install Xcode Command Line Tools."
  check_command "clang" "fail" "Install Xcode Command Line Tools."
  check_command "make" "fail" "Install developer command line tools and ensure PATH is configured."
  check_command "bash" "fail" "Install bash and ensure PATH is configured."
  check_command "python3" "warn" "Install python3 for helper scripts and JSON doctor output."
  check_command "curl" "warn" "Install curl for integration smoke checks."
  check_command "brew" "warn" "Install Homebrew for OpenSSL and optional libpq provisioning."
  xctest_path=""
  if command -v xctest >/dev/null 2>&1; then
    xctest_path="$(command -v xctest)"
  elif command -v xcrun >/dev/null 2>&1; then
    xctest_path="$(xcrun --find xctest 2>/dev/null || true)"
  fi
  if [[ -n "$xctest_path" ]]; then
    add_check "tool_xctest" "pass" "xctest found at $xctest_path"
  else
    add_check "tool_xctest" "warn" "xctest not found via PATH or xcrun" \
      "Activate full Xcode with 'sudo xcode-select -s /Applications/Xcode.app/Contents/Developer' and run 'sudo xcodebuild -runFirstLaunch'."
  fi

  sdk_path="$(xcrun --show-sdk-path 2>/dev/null || true)"
  if [[ -n "$sdk_path" && -d "$sdk_path" ]]; then
    add_check "apple_sdk" "pass" "macOS SDK available: $sdk_path"
  else
    add_check "apple_sdk" "fail" "unable to resolve macOS SDK path via xcrun" \
      "Install Xcode Command Line Tools or full Xcode."
  fi

  if [[ -n "$sdk_path" ]] && xcrun clang -isysroot "$sdk_path" -fobjc-arc -x objective-c -fsyntax-only - >/dev/null 2>&1 <<'EOF'
#import <Foundation/Foundation.h>
EOF
  then
    add_check "foundation_headers" "pass" "Apple Foundation headers are available to clang"
  else
    add_check "foundation_headers" "fail" "Apple Foundation headers are not available to clang" \
      "Verify Command Line Tools installation and xcrun SDK resolution."
  fi

  if [[ -n "$sdk_path" ]] && xcrun clang -isysroot "$sdk_path" -fobjc-arc -x objective-c -fsyntax-only - >/dev/null 2>&1 <<'EOF'
#import <dispatch/dispatch.h>
EOF
  then
    add_check "dispatch_headers" "pass" "dispatch/dispatch.h is available via the macOS SDK"
  else
    add_check "dispatch_headers" "fail" "dispatch/dispatch.h is missing from the active Apple SDK" \
      "Verify the active macOS SDK and Apple clang toolchain."
  fi

  apple_build_script="$repo_root/tools/build_apple.sh"
  if [[ -x "$apple_build_script" ]]; then
    add_check "apple_build_script" "pass" "Apple build script present: $apple_build_script"
  else
    add_check "apple_build_script" "fail" "Apple build script missing or not executable: $apple_build_script" \
      "Restore tools/build_apple.sh and mark it executable."
  fi

  openssl_prefix="${ARLEN_OPENSSL_PREFIX:-}"
  if [[ -z "$openssl_prefix" ]]; then
    openssl_prefix="$(aln_platform_first_brew_prefix openssl@3 || true)"
  fi
  if [[ -n "$openssl_prefix" && -d "$openssl_prefix/include/openssl" ]]; then
    add_check "openssl_headers" "pass" "OpenSSL headers available: $openssl_prefix"
  else
    add_check "openssl_headers" "fail" "OpenSSL headers not found for the Apple build path" \
      "Run 'brew install openssl@3' or set ARLEN_OPENSSL_PREFIX."
  fi

  libpq_prefix="${ARLEN_LIBPQ_PREFIX:-}"
  if [[ -z "$libpq_prefix" ]]; then
    libpq_prefix="$(aln_platform_first_brew_prefix libpq postgresql || true)"
  fi
  if [[ -n "$libpq_prefix" && -d "$libpq_prefix/lib" ]]; then
    add_check "libpq" "pass" "libpq candidate available: $libpq_prefix"
  else
    add_check "libpq" "warn" "libpq not detected for the Apple path" \
      "Install Homebrew 'libpq' or 'postgresql' if PostgreSQL support is required."
  fi

  odbc_prefix="${ARLEN_ODBC_PREFIX:-}"
  if [[ -z "$odbc_prefix" ]]; then
    odbc_prefix="$(aln_platform_first_brew_prefix unixodbc libiodbc || true)"
  fi
  if [[ -n "$odbc_prefix" && -d "$odbc_prefix/lib" ]]; then
    add_check "odbc" "pass" "ODBC candidate available: $odbc_prefix"
  else
    add_check "odbc" "warn" "ODBC manager not detected for the Apple path" \
      "Install Homebrew 'unixodbc' or 'libiodbc' if MSSQL transport is required."
  fi
else
  # Windows CLANG64 compiles Foundation/libdispatch headers with the same
  # workaround flags as the GNUmakefile (libdispatch's mode_t clash) and loads
  # libpq from a DLL, so those two checks differ there.
  windows_clang64=0
  probe_flags=""
  if aln_platform_is_msys; then
    windows_clang64=1
    probe_flags="-DHAVE_MODE_T=1 -D_FILE_OFFSET_BITS=64 -UGNUSTEP_WITH_DLL -DGNUSTEP_WITHOUT_DLL=1"
    add_check "platform" "pass" "platform: Windows MSYS2 CLANG64 (gnustep-cli toolchain) path"
    toolchain_state="/state/cli-state.json"
    if [[ -f "$toolchain_state" ]]; then
      toolchain_version="$(tr -d '\r' <"$toolchain_state" | sed -n 's/^[[:space:]]*"toolchain_version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
      add_check "toolchain" "pass" "gnustep-cli managed toolchain ${toolchain_version:-(unknown version)}"
    else
      add_check "toolchain" "warn" "not a gnustep-cli managed toolchain (no /state/cli-state.json)" \
        "Arlen's Windows release is built against the gnustep-cli managed CLANG64 toolchain; see docs/WINDOWS_CLANG64.md."
    fi
    if compgen -G "/clang64/lib/libcurl.dll.a" >/dev/null || compgen -G "/clang64/bin/libcurl*.dll" >/dev/null; then
      add_check "libcurl" "pass" "libcurl available in the toolchain"
    else
      add_check "libcurl" "fail" "libcurl is missing from the toolchain (Arlen links -lcurl)" \
        "Inside the toolchain run: pacman -S --noconfirm --needed mingw-w64-clang-x86_64-curl (never pacman -Sy or -Syu)."
    fi
  else
    add_check "platform" "pass" "platform: GNUstep/Linux bootstrap path"
  fi

  gnustep_script="$(bash "$repo_root/tools/resolve_gnustep.sh" 2>/dev/null || true)"
  if [[ -z "$gnustep_script" ]]; then
    gnustep_script="${GNUSTEP_SH:-/usr/GNUstep/System/Library/Makefiles/GNUstep.sh}"
  fi
  if [[ -f "$gnustep_script" ]]; then
    add_check "gnustep_script" "pass" "GNUstep script present: $gnustep_script"
  else
    add_check "gnustep_script" "fail" "missing GNUstep script: $gnustep_script" \
      "Set GNUSTEP_SH, export GNUSTEP_MAKEFILES, or source your toolchain env script before running Arlen."
  fi

  check_command "clang" "fail" "Install compiler toolchain and ensure PATH is configured."
  check_command "make" "fail" "Install make and ensure PATH is configured."
  check_command "bash" "fail" "Install bash and ensure PATH is configured."
  if [[ -f "$repo_root/vendor/tools-xctest/GNUmakefile" ]]; then
    add_check "tool_xctest" "pass" "vendored tools-xctest runner present (built on first 'arlen test')"
  else
    check_command "xctest" "warn" "Run 'git submodule update --init vendor/tools-xctest' or install tools-xctest for test execution."
  fi
  check_command "python3" "warn" "Install python3 for helper scripts and JSON doctor output."
  check_command "curl" "warn" "Install curl for integration smoke checks."

  if [[ -f "${gnustep_script:-}" ]]; then
    if bash -lc "set +u; source '$gnustep_script' >/dev/null 2>&1; set -u; gnustep-config --objc-flags >/dev/null"; then
      add_check "gnustep_config" "pass" "gnustep-config responded successfully"
    else
      add_check "gnustep_config" "fail" "failed running gnustep-config after sourcing GNUstep.sh" \
        "Verify your active GNUstep environment and gnustep-config availability."
    fi

    if bash -lc "set +u; source '$gnustep_script' >/dev/null 2>&1; set -u; printf '#import <dispatch/dispatch.h>\n' | clang \$(gnustep-config --objc-flags) $probe_flags -x objective-c -fsyntax-only - -MF /dev/null >/dev/null 2>&1"; then
      add_check "dispatch_headers" "pass" "dispatch/dispatch.h is available to clang"
    else
      add_check "dispatch_headers" "fail" "dispatch/dispatch.h is missing from the active toolchain include paths" \
        "Install libdispatch development headers/runtime support or use a GNUstep toolchain that exposes dispatch headers."
    fi
  fi

  if (( windows_clang64 == 1 )); then
    # Where ALNDefaultLibpqCandidatePaths looks: the release's bundled
    # build/dll first, then the toolchain's clang64/bin.
    libpq_dll=""
    for candidate in "$framework_root/build/dll/libpq-5.dll" "$framework_root/build/dll/libpq.dll" \
                     /clang64/bin/libpq-5.dll /clang64/bin/libpq.dll; do
      if [[ -f "$candidate" ]]; then
        libpq_dll="$candidate"
        break
      fi
    done
    if [[ -n "$libpq_dll" ]]; then
      add_check "libpq" "pass" "libpq available: $libpq_dll"
    else
      add_check "libpq" "warn" "libpq not found (release build/dll or toolchain clang64/bin)" \
        "Windows releases bundle libpq.dll in build/dll; a source checkout needs it only for PostgreSQL apps."
    fi
  elif command -v ldconfig >/dev/null 2>&1; then
    libpq_line="$(ldconfig -p 2>/dev/null | grep -m1 'libpq\\.so' || true)"
    if [[ -n "$libpq_line" ]]; then
      add_check "libpq" "pass" "libpq available: $libpq_line"
    else
      add_check "libpq" "warn" "libpq not detected via ldconfig" \
        "Install PostgreSQL client libraries (libpq) for ALNPg and migrations."
    fi
  else
    add_check "libpq" "warn" "ldconfig unavailable; skipping libpq detection" \
      "Verify libpq availability manually if PostgreSQL support is required."
  fi
fi

if (( as_json == 1 )); then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "arlen doctor: --json requires python3" >&2
    exit 1
  fi

  checks_payload="$(printf '%s\n' "${checks[@]}")"
  ARLEN_DOCTOR_CHECKS_PAYLOAD="$checks_payload" \
    python3 - "$app_root" "$framework_root" "$environment" "$pass_count" "$warn_count" "$fail_count" <<'PY'
import json
import os
import sys

app_root = sys.argv[1]
framework_root = sys.argv[2]
environment = sys.argv[3]
pass_count = int(sys.argv[4])
warn_count = int(sys.argv[5])
fail_count = int(sys.argv[6])

checks = []
for raw in os.environ.get("ARLEN_DOCTOR_CHECKS_PAYLOAD", "").splitlines():
    raw = raw.rstrip("\n")
    if not raw:
        continue
    parts = raw.split("\t", 3)
    while len(parts) < 4:
        parts.append("")
    check_id, status, message, hint = parts
    checks.append({
        "id": check_id,
        "status": status,
        "message": message,
        "hint": hint,
    })

payload = {
    "appRoot": app_root,
    "frameworkRoot": framework_root,
    "environment": environment,
    "summary": {
        "pass": pass_count,
        "warn": warn_count,
        "fail": fail_count,
    },
    "checks": checks,
}
print(json.dumps(payload, indent=2))
PY
else
  echo "Arlen doctor"
  echo "  app root: $app_root"
  if [[ -n "$framework_root" ]]; then
    echo "  framework root: $framework_root"
  else
    echo "  framework root: (unresolved)"
  fi
  echo "  environment: $environment"
  for entry in "${checks[@]}"; do
    IFS=$'\t' read -r check_id status message hint <<<"$entry"
    status_upper="$(printf '%s' "$status" | tr '[:lower:]' '[:upper:]')"
    printf '[%s] %s\n' "$status_upper" "$message"
    if [[ -n "$hint" ]]; then
      printf '       hint: %s\n' "$hint"
    fi
  done
  echo
  echo "Summary: pass=$pass_count warn=$warn_count fail=$fail_count"
  echo "Known-good matrix: docs/TOOLCHAIN_MATRIX.md"
fi

if (( fail_count > 0 )); then
  exit 1
fi
exit 0
