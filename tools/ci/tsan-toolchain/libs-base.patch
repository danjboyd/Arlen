index 835a5bb03..5d849d923 100644
--- a/Source/GSPrivate.h
+++ b/Source/GSPrivate.h
@@ -217,18 +217,43 @@ typedef union {
  * determined by the compiler) - an initial pointer to the string data
  * followed by the string length (number of characters).
  */
+/* Keep the existing packed flag/hash layout. Hash memoization writes this
+ * word even for immutable strings, so readers of adjacent flag bits must use
+ * the same atomic access. Relaxed ordering suffices for this derived value. */
+typedef struct {
+  unsigned int wide: 1;
+  unsigned int owned: 1;
+  unsigned int unused: 2;
+  unsigned int hash: 28;
+} GSStringFlags;
+
+static inline GSStringFlags
+GSStringLoadFlags(const GSStringFlags *flags)
+{
+  GSStringFlags result;
+  __atomic_load(flags, &result, __ATOMIC_RELAXED);
+  return result;
+}
+
+static inline unsigned int
+GSStringStoreHash(GSStringFlags *flags, unsigned int hash)
+{
+  GSStringFlags expected = GSStringLoadFlags(flags);
+  GSStringFlags desired;
+  do {
+    desired = expected;
+    desired.hash = hash;
+  } while (!__atomic_compare_exchange(flags, &expected, &desired, NO,
+                                      __ATOMIC_RELAXED, __ATOMIC_RELAXED));
+  return desired.hash;
+}
+
 @interface GSString : NSString
 {
 @public
   GSCharPtr _contents;
   unsigned int	_count;
-  struct {
-    unsigned int	wide: 1;	// 16-bit characters in string?
-    unsigned int	owned: 1;	// Set if the instance owns the
-					// _contents buffer
-    unsigned int	unused: 2;
-    unsigned int	hash: 28;
-  } _flags;
+  GSStringFlags _flags;
 }
 @end
 
