{
  identifier = "auth";
  version = "1.7.0";
  principalClass = "ALNAuthModule";
  dependencies = (
    { identifier = "jobs"; version = ">= 1.1.1"; required = NO; }
  );
  compatibility = {
    arlenVersion = ">= 0.1.0";
  };
  config = {
    defaults = {
      session = {
        enabled = YES;
      };
      csrf = {
        enabled = YES;
        allowQueryParamFallback = YES;
      };
      authModule = {
        defaultRedirect = "/";
        bootstrapAdminEmails = ();
        session = {
          absoluteLifetimeSeconds = 1209600;
        };
        mfa = {
          sms = {
            enabled = NO;
            allowEnrollment = YES;
            allowChallenge = YES;
            allowPrimaryFactor = NO;
            phoneManagementRequiresMFA = YES;
            recentMFAMaxAgeSeconds = 900;
            resendCooldownSeconds = 30;
            maxSendAttemptsPerSession = 5;
            maxVerifyAttemptsPerSession = 8;
            locale = "";
            accountSID = "";
            authToken = "";
            apiKeySID = "";
            apiKeySecret = "";
            verifyServiceSID = "";
            testVerificationCode = "";
          };
        };
        database = {
          /* Auth module connection pool; busy requests wait up to acquireTimeoutSeconds, then answer 503. */
          maxConnections = 8;
          acquireTimeoutSeconds = 2;
        };
        attemptLimits = {
          /* Failure counters (migration 004). maxFailures = 0 turns a limit off. */
          mfa = {
            maxFailures = 5;
            lockoutSeconds = 30;
            maxLockoutSeconds = 900;
          };
          password = {
            /* Per (email, client address) pair: delay after maxFailures, doubling. */
            maxFailures = 5;
            delaySeconds = 30;
            maxDelaySeconds = 900;
            /* Account-wide ceiling against distributed guessing (0 turns it off). */
            accountMaxFailures = 50;
            accountWindowSeconds = 3600;
            accountDelaySeconds = 30;
            maxTrackedEntries = 100000;
            pruneBatchSize = 1000;
            /* Pairs that signed in within this many days skip the account-wide ceiling (0 = off). */
            trustedPairDays = 30;
          };
          mail = {
            /* Forgot-password sends per hashed email / client address per window (0 = off). */
            maxPerEmail = 5;
            maxPerAddress = 20;
            windowSeconds = 3600;
          };
        };
        paths = {
          prefix = "/auth";
          apiPrefix = "api";
        };
        providers = {
          stub = {
            /* Development/test only: defaults on there when no real OIDC
               provider is enabled. Off in every other environment, where an
               explicit enabled = YES makes configuration fail. */
            email = "stub-user@example.test";
            displayName = "Stub Provider User";
            clientSecret = "auth-module-stub-provider-secret-0123456789abcdef";
          };
        };
        hooks = {
        };
      };
    };
    requiredKeys = (
      "session.secret",
      "database.connectionString"
    );
  };
}
